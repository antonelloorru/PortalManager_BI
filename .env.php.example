<?php
/**
 * certV 4.0 — .env.php.example
 *
 * Template di esempio. RINOMINARE in .env.php oppure lasciare che la prima
 * request del portale lo generi automaticamente (Env::bootstrapSecrets).
 *
 * IMPORTANTE:
 * - NON committare il file .env.php nel repository (è in .gitignore via .htaccess)
 * - Permessi consigliati: chmod 600 .env.php
 * - Cambiare i secret in caso di sospetto compromesso (ruoteranno tutti gli URL)
 */
return [
    // Ambiente: 'production' o 'development'
    'APP_ENV'        => 'production',

    // Debug: '1' abilita messaggi d'errore dettagliati. MAI 1 in production.
    'APP_DEBUG'      => '0',

    // Secret generale dell'applicazione (32 byte hex)
    'APP_SECRET'     => 'CAMBIARE_QUESTO_VALORE_IN_PRODUZIONE_64_CHARS_HEX',

    // Secret usato per generare/verificare i token CSRF
    'CSRF_SECRET'    => 'CAMBIARE_QUESTO_VALORE_IN_PRODUZIONE_64_CHARS_HEX',

    // Secret usato per generare gli slug opachi degli URL.
    // Cambiare = ruotare tutti gli URL del portale (i vecchi link smettono di funzionare)
    'URL_SECRET'     => 'CAMBIARE_QUESTO_VALORE_IN_PRODUZIONE_64_CHARS_HEX',

    // Secret per il fingerprint di sessione (HMAC del User-Agent)
    'SESSION_SECRET' => 'CAMBIARE_QUESTO_VALORE_IN_PRODUZIONE_64_CHARS_HEX',

    // Forza Secure flag sui cookie. Mettere '1' SOLO quando HTTPS è attivo.
    'COOKIE_SECURE'  => '0',

    // Pretty URLs via mod_rewrite. Se mod_rewrite non è disponibile, '0'.
    'USE_PRETTY_URLS' => '1',
];
