<?php
/**
 * PortalManager — .env.example
 * Template per la configurazione locale/istanza (.env.php).
 * Rinominare in '.env.php' nella root dell'applicazione.
 * Questo file NON deve essere tracciato nel version control in produzione.
 */
return [
    // --- Parametri Database ---
    'DB_HOST'              => 'localhost',
    'DB_PORT'              => '3306',
    'DB_NAME'              => 'portalmanager',
    'DB_USER'              => 'root',
    'DB_PASS'              => '',
    'DB_CHARSET'           => 'utf8mb4',

    // --- Parametri Applicazione & Debug ---
    'APP_ENV'              => 'production', // 'development' | 'production'
    'APP_DEBUG'            => '0',          // '1' per mostrare dettagli errori, '0' in produzione
    'USE_PRETTY_URLS'      => '1',          // '1' per /app/<slug>, '0' per r.php?r=<slug>

    // --- Chiavi di Sicurezza (generate randomicamente al primo avvio se assenti) ---
    'APP_SECRET'           => 'genera_chiave_random_32_bytes',
    'CSRF_SECRET'          => 'genera_chiave_random_32_bytes',
    'URL_SECRET'           => 'genera_chiave_random_32_bytes',
    'SESSION_SECRET'       => 'genera_chiave_random_32_bytes',

    // --- Isolamento Sessioni Multi-Istanza & Cookie Scoping ---
    'COOKIE_SECURE'        => '0',          // '1' se il sito usa HTTPS
    'COOKIE_SAMESITE'      => 'Lax',        // 'Lax' o 'Strict'
    // 'SESSION_COOKIE_NAME'  => 'PMSESS_custom', // opzionale: se omesso, calcolato dinamicamente da hash(APP_BASE)
    // 'SESSION_COOKIE_PATH'  => '/portalmanager/', // opzionale: se omesso, calcolato dinamicamente da Router::base()
];
